# GEMINI_API_KEY: Required for Gemini AI Cyber Coach API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side passcode to unlock Admin Moderation Console.
# If unset, the Admin tab provides a one-time first-run admin claim form.
ADMIN_PASSCODE=
